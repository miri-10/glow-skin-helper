# Database Configuration
MONGODB_URI=mongodb://localhost:27017/skin_cancer_detection
MONGODB_TEST_URI=mongodb://localhost:27017/skin_cancer_detection_test

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secure_refresh_token_secret_here

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here

# API Keys (if needed for external services)
OPENAI_API_KEY=your_openai_api_key_here